# Delay installing newly published packages so registries can detect and pull
# compromised releases first (https://paretosecurity.com/mac/checks/package-manager-release-age).
# npm/Yarn read min-release-age (days); pnpm reads minimum-release-age (minutes).
min-release-age=7
minimum-release-age=10080

# Pin exact versions instead of semver ranges.
save-exact=true
