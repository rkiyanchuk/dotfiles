# APPEARANCE

theme = Atom One Dark
# theme = dark:Atom One Dark,light:One Double Light

font-family = IosevkaTerm Nerd Font
font-style = Light
font-size = 17

adjust-cell-height = 20%
cursor-style = block
window-subtitle = working-directory

# BEHAVIOR

auto-update = off
macos-applescript = false
macos-auto-secure-input = true
macos-option-as-alt = left
macos-secure-input-indication = true
macos-titlebar-style = native
macos-titlebar-proxy-icon = hidden
maximize = true
mouse-hide-while-typing = true
mouse-scroll-multiplier = discrete:1
notify-on-command-finish = unfocused
notify-on-command-finish-action = bell, notify
quit-after-last-window-closed = true
shell-integration-features = no-cursor, sudo, ssh-env, ssh-terminfo
window-padding-balance = true
window-padding-x = 5
window-padding-y = 5
window-save-state = always
window-vsync = true

# QUICK TERMINAL
keybind = global:cmd+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-space-behavior = move

# KEY BINDINGS

keybind = shift+enter=text:\x1b\r
keybind = cmd+n=unbind
keybind = cmd+shift+n=new_window
