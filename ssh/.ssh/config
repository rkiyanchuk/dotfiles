Include ~/.orbstack/ssh/config

Host *
  IgnoreUnknown UseKeychain
  UseKeychain yes
  AddKeysToAgent yes
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_ed25519_git

Host github.com
  IdentityFile ~/.ssh/id_ed25519_git

Host rpi
  HostName 192.168.192.40
  User ruslan
  IdentityFile ~/.ssh/rpi

# HARDENING
Host *
  ForwardX11Trusted no
  UpdateHostKeys yes
  HashKnownHosts yes
