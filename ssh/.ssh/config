Include ~/.orbstack/ssh/config

Host *
  IgnoreUnknown UseKeychain
  UseKeychain yes
  AddKeysToAgent yes
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_ed25519_git

Host github.com
  IdentityFile ~/.ssh/id_ed25519_git

Host rpi
  HostName rpi.local
  User ruslan
  IdentityFile ~/.ssh/rpi

Host ts-rpi
  HostName rpi.tail08ee3a.ts.net
  User ruslan
  IdentityFile ~/.ssh/rpi

# HARDENING
Host *
  ForwardX11Trusted no
  UpdateHostKeys yes
  HashKnownHosts yes
